# =============================================================================
# Tip Top Welding Store — Stripe Payment Links (Netlify / production env vars)
# =============================================================================
#
# 1. In Stripe Dashboard: Products → Payment Links → create a link per store item.
# 2. Copy each full URL (https://buy.stripe.com/... or https://link.stripe.com/...).
# 3. Paste into the matching variable below (Netlify: Site configuration → Environment).
# 4. Redeploy the site so Vite embeds the values at build time.
#
# Mapping (product id in src/config/store.ts → env var → Store "Buy Now"):
#
#   mailbox-installation-coastal     Mail Box Installation — Coastal Series ($250)
#   pool-rail-installation-nautical  Pool Rail Installation — Nautical Series ($500)
#   powder-coat                      Powder Coat ($250)
#   dolphin-pool-rail                Dolphin Pool Rail ($3,500)
#   nautilus-pool-rail               Nautilus Pool Rail ($3,500)
#   dolphin-mailbox-stand            Dolphin Mail Box Stand ($2,800)
#   burrowing-owl-mailbox-stand      Burrowing Owl Mailbox Stand ($3,200)
#
# Leave blank to disable live checkout for that item (disabled Buy Now + Request This Item).

VITE_STORE_CHECKOUT_MAILBOX_INSTALLATION_COASTAL=
VITE_STORE_CHECKOUT_POOL_RAIL_INSTALLATION_NAUTICAL=
VITE_STORE_CHECKOUT_POWDER_COAT=
VITE_STORE_CHECKOUT_DOLPHIN_POOL_RAIL=
VITE_STORE_CHECKOUT_NAUTILUS_POOL_RAIL=
VITE_STORE_CHECKOUT_DOLPHIN_MAILBOX_STAND=
VITE_STORE_CHECKOUT_BURROWING_OWL_MAILBOX_STAND=
